# Optional live LLM. Leave empty for the offline cited template path.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Host tools talk to published compose ports (high, to avoid local clashes)
DATABASE_URL=postgresql://dg:dg@localhost:35432/driveguard

MQTT_BROKER=localhost
MQTT_PORT=31883

DG_LOG_LEVEL=INFO
DG_SEED=42

# 1 = deterministic offline LLM path (CI/demo without API keys)
DG_OFFLINE_LLM=1

# 1 = subscribe to MQTT inside the API process (compose sets this)
DG_MQTT_CONSUMER=0
